# Local development only; copy to .env (ignored).
CAREER_AGENT_DATABASE_URL=postgresql+asyncpg://career:career_local_only@127.0.0.1:55432/career_agent
CAREER_AGENT_DATA_DIR=~/.local/share/career-agent
# Optional integration test server; role must have CREATEDB.
# CAREER_AGENT_TEST_DATABASE_URL=postgresql+asyncpg://career:career_local_only@127.0.0.1:55432/postgres

# Trusted operator settings only; never accepted in ResumeVariant payloads.
CAREER_AGENT_TYPST_BIN=typst
CAREER_AGENT_COMPILE_TIMEOUT_SECONDS=15
# External pinned fonts; setup script verifies official file SHA-256 values.
CAREER_AGENT_FONT_DIR=~/.cache/career-agent/fonts/noto-sans-cjk-sc-2.004

# Explicit live mode only. Never paste keys into chat or commit .env.
OPENAI_API_KEY=
TAVILY_API_KEY=
CAREER_AGENT_LIVE_ENABLED=false
CAREER_AGENT_CHEAP_MODEL=gpt-6-luna
CAREER_AGENT_STRONG_MODEL=gpt-6.1-sol
CAREER_AGENT_PREMIUM_MODEL=gpt-6-astra
# Reserved contract: premium is never registered/automatically called in v0.1c.
CAREER_AGENT_PREMIUM_ENABLED=false
CAREER_AGENT_MODEL_TIMEOUT_SECONDS=60
# HTTP transport phase timeouts, independent of workflow token/cost budgets.
CAREER_AGENT_MODEL_TASK_TIMEOUT_SECONDS='{"interview_preparation":120}'
CAREER_AGENT_MODEL_RETRY_LIMIT=1
CAREER_AGENT_SCHEMA_REPAIR_LIMIT=1
CAREER_AGENT_MAX_RUN_COST=1
CAREER_AGENT_COMPANY_RESEARCH_TTL_HOURS=168
# Bounded transaction-claim wait; timeout makes no provider call.
CAREER_AGENT_REUSE_CLAIM_WAIT_SECONDS=5
CAREER_AGENT_SEARCH_TIMEOUT_SECONDS=15
# USD estimate per Tavily basic credit; adjust for your plan, not a billing guarantee.
# PAYG-equivalent retail estimate, not actual cash cost; free-credit coverage is unknown.
CAREER_AGENT_SEARCH_COST_PER_CALL=0.008
# Model prices in USD / million tokens. Update together when overriding model IDs.
CAREER_AGENT_CHEAP_INPUT_PRICE=0.10
CAREER_AGENT_CHEAP_CACHED_PRICE=0.01
CAREER_AGENT_CHEAP_OUTPUT_PRICE=0.50
CAREER_AGENT_STRONG_INPUT_PRICE=2
CAREER_AGENT_STRONG_CACHED_PRICE=0.10
CAREER_AGENT_STRONG_OUTPUT_PRICE=10
CAREER_AGENT_PRICING_VERSION=openai-standard-2026-10-10

# Metadata-only Ops API. Unset token denies operator access; never commit a real token.
CAREER_AGENT_OPS_TOKEN=
# Live mode starts the durable controller automatically. Enable this for offline Ops only.
CAREER_AGENT_OPS_ENABLED=false
# Versioned bounded control; defaults include min observations, hysteresis/cooldown and bounds.
# CAREER_AGENT_AUTOMATIC_CONTROL='{"version":"automatic-control-v1","enabled":true}'
